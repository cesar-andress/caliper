# CALIPER environment configuration
# Copy to .env and fill in values before running experiments.

# --- API model providers ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Legacy alias accepted by GeminiProvider when GEMINI_API_KEY is unset:
# GOOGLE_API_KEY=

# Optional: model IDs for live integration tests (pytest -m integration)
# CALIPER_OPENAI_MODEL=
# CALIPER_ANTHROPIC_MODEL=
# CALIPER_GEMINI_MODEL=

# --- Local model runtime ---
# Path to local HuggingFace checkout, GGUF file, or hub id (org/model)
LOCAL_MODEL_PATH=
# Enable provider-level dry-run (skip inference, deterministic placeholders)
# CALIPER_PROVIDER_DRY_RUN=0

# --- Experiment defaults ---
CALIPER_OUTPUT_DIR=./outputs
CALIPER_LOG_LEVEL=INFO
CALIPER_SEED=42

# --- Optional: Weights & Biases tracking ---
# WANDB_API_KEY=
# WANDB_PROJECT=caliper
